{
  "name": "myterminal",
  "version": "0.1.0",
  "description": "A macOS desktop terminal with managed local and SSH connections.",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "pack": "npm run pack:mac",
    "pack:mac": "npm run icon:mac && npm run build && electron-builder --mac dir",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run icon:mac && npm run build && electron-builder --mac zip",
    "dmg:mac": "npm run icon:mac && npm run build && electron-builder --mac dmg",
    "package:mac": "bash scripts/build-macos-app.sh",
    "icon:mac": "bash scripts/create-macos-icon.sh",
    "app": "npm run package:mac",
    "installer": "npm run dist",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "overrides": {
    "node-gyp": "^10.3.1"
  },
  "build": {
    "appId": "com.myterminal.app",
    "productName": "MyTerminal",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "afterPack": "scripts/prune-macos-package.js",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json",
      "!assets/app-icon-source.png"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "assets/app-icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "MyTerminal",
        "CFBundleName": "MyTerminal"
      }
    },
    "dmg": {
      "title": "MyTerminal ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
